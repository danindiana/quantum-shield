digraph coverage {
  bgcolor="#0b0f14";
  rankdir=LR;
  fontname="Helvetica";
  fontcolor="#c9d1d9";
  labelloc="t";
  label="test coverage map — what's actually verified vs. exercised manually";
  fontsize=20;
  node [style=filled, fillcolor="#161b22", color="#39ffe0", fontcolor="#e6edf3", fontname="Helvetica", penwidth=2, shape=box, margin="0.25,0.15"];
  edge [color="#8f5cff", fontcolor="#c9d1d9", fontname="Helvetica", penwidth=1.6, fontsize=11];

  subgraph cluster_tested {
    label="covered by pytest (53 tests)";
    fontcolor="#39ffe0";
    color="#39ffe0";
    style=dashed;
    kem_tests [label="MLKEM768: sizes, keypair,\nencaps/decaps round-trip,\nwrong-key rejection", color="#39ffe0"];
    sig_tests [label="Signature/MLDSA65/SLHDSA128s:\nsizes, keypair, sign/verify,\ntampered-message rejection,\nwrong-key rejection", color="#39ffe0"];
    setup_tests [label="project structure,\nconfig file, liboqs presence"];
    kms_tests [label="KeyStore: save/load/list/\ndelete/rotate/revoke/history,\nwrong-passphrase, revoked-key\nblocking", color="#39ffe0"];
    pki_tests [label="certs.py: verifies REAL\nML-DSA-65 + Falcon-512 certs\ngenerated by openssl this\nsession, wrong-key rejection", color="#39ffe0"];
    tls_tests [label="demo.py: real TLS 1.3\nhandshake with ML-KEM-768,\nnegative control (mismatched\ngroups fail)", color="#39ffe0"];
  }

  subgraph cluster_manual {
    label="exercised manually this session, not in pytest";
    fontcolor="#ffcb47";
    color="#ffcb47";
    style=dashed;
    ssh_manual [label="simple_ssh_keygen.py\nend-to-end (both algorithms)"];
    falcon_manual [label="Falcon512 subclass"];
    benchmark_manual [label="quantum_shield.py benchmark\n-- real numbers written to file"];
    server_manual [label="quantum_shield.py server +\nkem_demo_client.py -- real TCP\nhandshake, matching secrets"];
  }

  subgraph cluster_untested {
    label="not exercised at all";
    fontcolor="#ff2ec4";
    color="#ff2ec4";
    style=dashed;
    tlstest [label="test_pq_tls.py itself\n(the script -- its underlying\nopenssl+oqs-provider cert-gen\npath IS now exercised by\ntest_pki_certs.py and\ntest_tls_demo.py)"];
  }
}
