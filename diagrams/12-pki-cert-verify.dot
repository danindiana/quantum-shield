digraph pki {
  bgcolor="#0b0f14";
  rankdir=TB;
  fontname="Helvetica";
  fontcolor="#c9d1d9";
  labelloc="t";
  label="src/pki/certs.py — verifying a PQ X.509 cert without reimplementing DER";
  fontsize=20;
  node [style=filled, fillcolor="#161b22", color="#39ffe0", fontcolor="#e6edf3", fontname="Helvetica", penwidth=2, shape=box, margin="0.25,0.15"];
  edge [color="#8f5cff", fontcolor="#c9d1d9", fontname="Helvetica", penwidth=1.6, fontsize=11];

  subgraph cluster_delegated {
    label="delegated to vetted code -- never reimplemented here";
    fontcolor="#ffcb47";
    color="#ffcb47";
    style=dashed;
    openssl [label="openssl + oqs-provider\nbuilds/signs the cert\n(test_pq_tls.py)", color="#ffcb47", shape=box3d];
    cryptoparse [label="cryptography's X.509 parser\nparses structure -- works even\nfor an algorithm it can't verify", color="#ffcb47", shape=box3d];
  }

  subgraph cluster_thismodule {
    label="src/pki/certs.py -- generic DER walk + real crypto check";
    fontcolor="#39ffe0";
    color="#39ffe0";
    style=dashed;
    tbs [label="cert.tbs_certificate_bytes\ncert.signature\ncert.signature_algorithm_oid"];
    oidmap [label="algorithm_for_certificate()\nKNOWN_SIGNATURE_OIDS table\n(verified against this host's\nreal oqs-provider build,\nnot guessed)", color="#ff2ec4"];
    dertlv [label="extract_raw_public_key()\ngeneric DER TLV walker --\nskips 5 fixed-order TBSCertificate\nfields, reads SPKI's BIT STRING", color="#ff2ec4"];
    verify [label="verify_certificate_signature()\n-> Signature(algorithm).verify(...)\n(same tested liboqs binding\nas everywhere else)", color="#39ffe0"];
  }

  result [label="True/False --\nverified against 2 REAL certs\n(ML-DSA-65, Falcon-512)\ngenerated by openssl this session", shape=note, color="#39ffe0"];

  scope [label="does NOT do: multi-step chains,\nkey usage, extensions, revocation --\nverify_chain() covers one\nleaf-to-issuer link, see diagram 14", shape=note, color="#8a99a8"];

  openssl -> tbs [label="produces\nthe cert"];
  tbs -> cryptoparse [style=dashed];
  cryptoparse -> oidmap;
  cryptoparse -> dertlv;
  oidmap -> verify;
  dertlv -> verify;
  verify -> result;
  result -> scope [style=dotted];
}
